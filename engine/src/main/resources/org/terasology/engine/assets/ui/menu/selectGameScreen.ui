{
    "type": "engine:selectGameScreen",
    "skin": "engine:mainMenuDim",
    "contents": {
        "type": "relativeLayout",
        "contents": [
            {
                "type": "UILabel",
                "id": "subtitle",
                "family": "title",
                "text": "${engine:menu#your-games}",
                "layoutInfo": {
                    "width": 400,
                    "height": 52,
                    "position-left": {
                        "offset": 70
                    },
                    "position-top": {
                        "target": "TOP",
                        "offset": 40
                    }
                }
            },
            {
                "type": "UILabel",
                "id": "gameTypeTitle",
                "family": "caps",
                "layoutInfo": {
                    "width": 320,
                    "height": 24,
                    "position-left": {
                        "target": "RIGHT",
                        "widget": "subtitle",
                        "offset": 16
                    },
                    "position-bottom": {
                        "target": "BOTTOM",
                        "widget": "subtitle",
                        "offset": 10
                    }
                }
            },
            {
                "type": "UIBox",
                "id": "listPanel",
                "layoutInfo": {
                    "width": 440,
                    "position-left": {
                        "offset": 70
                    },
                    "position-top": {
                        "target": "BOTTOM",
                        "widget": "subtitle",
                        "offset": 16
                    },
                    "position-bottom": {
                        "offset": 40
                    }
                },
                "content": {
                    "type": "relativeLayout",
                    "contents": [
                        {
                            "type": "UIButton",
                            "id": "create",
                            "text": "${engine:menu#new-game-action}",
                            "layoutInfo": {
                                "height": 46,
                                "position-left": {},
                                "position-right": {},
                                "position-bottom": {}
                            }
                        },
                        {
                            "type": "ScrollableArea",
                            "id": "gameListArea",
                            "content": {
                                "type": "UIList",
                                "id": "gameList"
                            },
                            "layoutInfo": {
                                "position-left": {},
                                "position-right": {},
                                "position-top": {
                                    "offset": 20
                                },
                                "position-bottom": {
                                    "target": "TOP",
                                    "widget": "create",
                                    "offset": 12
                                }
                            }
                        }
                    ]
                }
            },
            {
                "type": "UIBox",
                "id": "detailPanel",
                "layoutInfo": {
                    "position-left": {
                        "target": "RIGHT",
                        "widget": "listPanel",
                        "offset": 24
                    },
                    "position-right": {
                        "offset": 70
                    },
                    "position-top": {
                        "target": "BOTTOM",
                        "widget": "subtitle",
                        "offset": 16
                    },
                    "position-bottom": {
                        "offset": 40
                    }
                },
                "content": {
                    "type": "relativeLayout",
                    "contents": [
                        {
                            "type": "UILabel",
                            "id": "detailTitle",
                            "family": "panel-title",
                            "layoutInfo": {
                                "height": 40,
                                "position-horizontal-center": {},
                                "position-top": {
                                    "offset": 20
                                }
                            }
                        },
                        {
                            "type": "RowLayout",
                            "id": "detailActions",
                            "horizontalSpacing": 12,
                            "contents": [
                                {
                                    "type": "UIButton",
                                    "id": "duplicate",
                                    "family": "btn-secondary",
                                    "text": "${engine:menu#duplicate-game}",
                                    "layoutInfo": {
                                        "relativeWidth": 0.24
                                    }
                                },
                                {
                                    "type": "UIButton",
                                    "id": "delete",
                                    "family": "btn-danger",
                                    "text": "${engine:menu#delete-game}",
                                    "layoutInfo": {
                                        "relativeWidth": 0.24
                                    }
                                },
                                {
                                    "type": "UISpace",
                                    "layoutInfo": {
                                        "relativeWidth": 0.08
                                    }
                                },
                                {
                                    "type": "UIButton",
                                    "id": "close",
                                    "family": "btn-secondary",
                                    "text": "${engine:menu#back}",
                                    "layoutInfo": {
                                        "relativeWidth": 0.2
                                    }
                                },
                                {
                                    "type": "UIButton",
                                    "id": "load",
                                    "text": "${engine:menu#play-game}",
                                    "layoutInfo": {
                                        "relativeWidth": 0.24
                                    }
                                }
                            ],
                            "layoutInfo": {
                                "height": 46,
                                "position-left": {},
                                "position-right": {},
                                "position-bottom": {}
                            }
                        },
                        {
                            "type": "RowLayout",
                            "id": "detailStats",
                            "horizontalSpacing": 12,
                            "contents": [
                                {
                                    "type": "ColumnLayout",
                                    "columns": 1,
                                    "verticalSpacing": 2,
                                    "contents": [
                                        {
                                            "type": "UILabel",
                                            "family": "caps",
                                            "text": "${engine:menu#last-session}"
                                        },
                                        {
                                            "type": "UILabel",
                                            "id": "detailLastPlayed",
                                            "family": "secondary"
                                        }
                                    ],
                                    "family": "stat-box"
                                },
                                {
                                    "type": "ColumnLayout",
                                    "columns": 1,
                                    "verticalSpacing": 2,
                                    "contents": [
                                        {
                                            "type": "UILabel",
                                            "family": "caps",
                                            "text": "${engine:menu#playtime}"
                                        },
                                        {
                                            "type": "UILabel",
                                            "id": "detailPlaytime",
                                            "family": "numeric"
                                        }
                                    ],
                                    "family": "stat-box"
                                },
                                {
                                    "type": "ColumnLayout",
                                    "columns": 1,
                                    "verticalSpacing": 2,
                                    "contents": [
                                        {
                                            "type": "UILabel",
                                            "family": "caps",
                                            "text": "${engine:menu#mode-label}"
                                        },
                                        {
                                            "type": "UILabel",
                                            "id": "detailMode",
                                            "family": "secondary"
                                        }
                                    ],
                                    "family": "stat-box"
                                }
                            ],
                            "layoutInfo": {
                                "height": 52,
                                "position-left": {},
                                "position-right": {},
                                "position-bottom": {
                                    "target": "TOP",
                                    "widget": "detailActions",
                                    "offset": 20
                                }
                            }
                        },
                        {
                            "type": "UIImageSlideshow",
                            "id": "previewImage",
                            "layoutInfo": {
                                "position-left": {},
                                "position-right": {},
                                "position-top": {
                                    "target": "BOTTOM",
                                    "widget": "detailTitle",
                                    "offset": 10
                                },
                                "position-bottom": {
                                    "target": "TOP",
                                    "widget": "detailStats",
                                    "offset": 20
                                }
                            }
                        }
                    ]
                }
            }
        ]
    }
}
