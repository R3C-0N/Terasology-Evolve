{
    "inherit": "default",
    "elements": {
        "ScrollableArea": {
            "background": "engine:area",
            "background-border": {
                "top": 12,
                "bottom": 12,
                "left": 12,
                "right": 12
            },
            "background-scale-mode": "tiled"
        },
        "UILabel": {
            "text-align-horizontal": "LEFT",
            "text-align-vertical": "top",
            "text-shadowed": false
        }
    }
}
