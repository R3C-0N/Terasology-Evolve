{
    "inherit": "default",
    "elements": {
        "UIBox": {
            "background": "engine:box",
            "background-border": {
                "top": 12,
                "bottom": 12,
                "left": 12,
                "right": 12
            },
            "background-scale-mode": "tiled"
        },
        "UITabBox": {
            "background": "engine:box",
            "background-border": {
                "top": 12,
                "bottom": 12,
                "left": 12,
                "right": 12
            },
            "margin": {
                "top": 6,
                "bottom": 6,
                "left": 6,
                "right": 6
            },
            "background-scale-mode": "tiled"
        }
    },
    "families": {
        "subheading": {
            "font": "Uncial-Item",
            "text-align-horizontal": "center",
            "margin": {
                "bottom": 4,
                "left": 4
            }
        }
    }
}
