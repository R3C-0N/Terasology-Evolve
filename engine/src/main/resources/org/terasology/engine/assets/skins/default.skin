{
    "font": "Grenze-Body",
    "text-color": "FFF3DCFF",
    "text-shadowed": true,
    "text-shadow-color": "17100CFF",
    "elements": {
        "UILabel": {
            "text-align-vertical": "top",
            "modes": {
                "enabled": {
                    "text-color": "FFF3DCFF"
                },
                "disabled": {
                    "text-color": "B49E7CFF"
                }
            }
        },
        "UITooltip": {
            "background": "engine:area",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 9,
                "bottom": 9,
                "left": 9,
                "right": 9
            },
            "margin": {
                "top": 10,
                "bottom": 10,
                "left": 16,
                "right": 16
            },
            "text-align-horizontal": "left",
            "text-align-vertical": "bottom",
            "text-color": "F2E2C0FF"
        },
        "UIText": {
            "text-align-horizontal": "left",
            "text-align-vertical": "top",
            "text-color": "FFF3DCFF",
            "hint-text-color": "B49E7CFF",
            "background": "engine:box",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 12,
                "bottom": 12,
                "left": 12,
                "right": 12
            },
            "margin": {
                "top": 6,
                "bottom": 6,
                "left": 14,
                "right": 14
            },
            "modes": {
                "disabled": {
                    "background": "engine:boxDisabled",
                    "text-color": "B49E7CFF"
                }
            }
        },
        "ResettableUIText": {
            "text-align-horizontal": "left",
            "text-align-vertical": "top",
            "text-color": "FFF3DCFF",
            "hint-text-color": "B49E7CFF",
            "background": "engine:resetBox",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 12,
                "bottom": 12,
                "left": 12,
                "right": 42
            },
            "margin": {
                "top": 8,
                "bottom": 8,
                "left": 16,
                "right": 48
            },
            "modes": {
                "disabled": {
                    "background": "engine:resetBoxDisabled",
                    "text-color": "B49E7CFF"
                }
            }
        },
        "UIImage": {
            "texture-scale-mode": "scale fit"
        },
        "UIImageSlideshow": {
            "texture-scale-mode": "scale fit"
        },
        "RowLayout": {},
        "UIBox": {
            "background": "engine:panel",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 90,
                "bottom": 90,
                "left": 90,
                "right": 90
            },
            "margin": {
                "top": 52,
                "bottom": 52,
                "left": 52,
                "right": 52
            }
        },
        "UITabBox": {
            "background": "engine:panel",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 90,
                "bottom": 90,
                "left": 90,
                "right": 90
            },
            "margin": {
                "top": 52,
                "bottom": 52,
                "left": 52,
                "right": 52
            }
        },
        "UILoadBar": {
            "background": "engine:box",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 12,
                "bottom": 12,
                "left": 12,
                "right": 12
            },
            "margin": {
                "top": 6,
                "bottom": 6,
                "left": 6,
                "right": 6
            },
            "min-width": 256,
            "max-width": 512,
            "fixed-height": 26
        },
        "UIList": {
            "parts": {
                "item": {
                    "text-align-horizontal": "left",
                    "text-align-vertical": "middle",
                    "text-color": "F2E2C0FF",
                    "background": "engine:listItem",
                    "background-scale-mode": "tiled",
                    "background-border": {
                        "top": 6,
                        "bottom": 6,
                        "left": 18,
                        "right": 6
                    },
                    "margin": {
                        "top": 8,
                        "bottom": 8,
                        "left": 24,
                        "right": 12
                    },
                    "modes": {
                        "hover": {
                            "background": "engine:listItemHover",
                            "text-color": "FFF3DCFF"
                        },
                        "active": {
                            "background": "engine:listItemSelected",
                            "text-color": "FFF3DCFF"
                        },
                        "disabled": {
                            "background": "engine:listItem",
                            "text-color": "B49E7CFF"
                        }
                    }
                }
            }
        },
        "UIDropdown": {
            "text-align-horizontal": "left",
            "fixed-height": 36,
            "parts": {
                "base": {
                    "background": "engine:dropdown",
                    "background-scale-mode": "tiled",
                    "background-border": {
                        "top": 12,
                        "bottom": 12,
                        "left": 12,
                        "right": 42
                    },
                    "margin": {
                        "top": 6,
                        "bottom": 6,
                        "left": 18,
                        "right": 48
                    },
                    "modes": {
                        "active": {
                            "background": "engine:dropdownActive"
                        },
                        "disabled": {
                            "background": "engine:dropdownDisabled",
                            "text-color": "B49E7CFF"
                        }
                    }
                },
                "list": {
                    "background": "engine:dropdownList",
                    "background-scale-mode": "tiled",
                    "background-border": {
                        "top": 0,
                        "bottom": 12,
                        "left": 12,
                        "right": 12
                    },
                    "margin": {
                        "top": 4,
                        "bottom": 8,
                        "left": 10,
                        "right": 10
                    }
                },
                "list-item": {
                    "margin": {
                        "top": 6,
                        "bottom": 6,
                        "left": 12,
                        "right": 12
                    },
                    "modes": {
                        "hover": {
                            "background": "engine:dropdownListItemActive",
                            "background-scale-mode": "tiled",
                            "background-border": {
                                "top": 6,
                                "bottom": 6,
                                "left": 18,
                                "right": 6
                            },
                            "text-color": "FFF3DCFF"
                        }
                    }
                }
            }
        },
        "UIDropdownScrollable": {
            "text-align-horizontal": "left",
            "fixed-height": 36,
            "parts": {
                "base": {
                    "background": "engine:dropdown",
                    "background-scale-mode": "tiled",
                    "background-border": {
                        "top": 12,
                        "bottom": 12,
                        "left": 12,
                        "right": 42
                    },
                    "margin": {
                        "top": 6,
                        "bottom": 6,
                        "left": 18,
                        "right": 48
                    },
                    "modes": {
                        "active": {
                            "background": "engine:dropdownActive"
                        },
                        "disabled": {
                            "background": "engine:dropdownDisabled",
                            "text-color": "B49E7CFF"
                        }
                    }
                },
                "list": {
                    "background": "engine:dropdownList",
                    "background-scale-mode": "tiled",
                    "background-border": {
                        "top": 0,
                        "bottom": 12,
                        "left": 12,
                        "right": 12
                    },
                    "margin": {
                        "top": 4,
                        "bottom": 8,
                        "left": 10,
                        "right": 10
                    }
                },
                "list-item": {
                    "margin": {
                        "top": 6,
                        "bottom": 6,
                        "left": 12,
                        "right": 12
                    },
                    "modes": {
                        "hover": {
                            "background": "engine:dropdownListItemActive",
                            "background-scale-mode": "tiled",
                            "background-border": {
                                "top": 6,
                                "bottom": 6,
                                "left": 18,
                                "right": 6
                            },
                            "text-color": "FFF3DCFF"
                        }
                    }
                }
            }
        },
        "UIButton": {
            "text-align-horizontal": "center",
            "text-align-vertical": "middle",
            "text-color": "FFF3DCFF",
            "background": "engine:button",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 9,
                "bottom": 18,
                "left": 9,
                "right": 9
            },
            "margin": {
                "top": 6,
                "bottom": 18,
                "left": 18,
                "right": 18
            },
            "min-height": 44,
            "modes": {
                "hover": {
                    "background": "engine:buttonOver"
                },
                "down": {
                    "background": "engine:buttonDown",
                    "text-color": "FFE08CFF",
                    "margin": {
                        "top": 12,
                        "bottom": 12,
                        "left": 18,
                        "right": 18
                    }
                },
                "disabled": {
                    "background": "engine:buttonDisabled",
                    "text-color": "B49E7CFF"
                }
            }
        },
        "UIInputBind": {
            "text-align-horizontal": "center",
            "text-align-vertical": "middle",
            "text-color": "FFF3DCFF",
            "background": "engine:button",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 9,
                "bottom": 18,
                "left": 9,
                "right": 9
            },
            "margin": {
                "top": 6,
                "bottom": 18,
                "left": 14,
                "right": 14
            },
            "min-height": 44,
            "modes": {
                "hover": {
                    "background": "engine:buttonOver"
                },
                "active": {
                    "background": "engine:buttonDown",
                    "text-color": "FFE08CFF"
                }
            }
        },
        "UICheckbox": {
            "background": "engine:checkbox",
            "fixed-width": 36,
            "fixed-height": 36,
            "text-align-horizontal": "left",
            "modes": {
                "hover": {
                    "background": "engine:checkboxHover"
                },
                "active": {
                    "background": "engine:checkboxChecked"
                },
                "hover-active": {
                    "background": "engine:checkboxCheckedHover"
                },
                "disabled": {
                    "background": "engine:checkboxDisabled"
                },
                "disabled-active": {
                    "background": "engine:checkboxCheckedDisabled"
                }
            }
        },
        "ScrollableArea": {
            "background": "engine:area",
            "background-scale-mode": "tiled",
            "background-border": {
                "top": 9,
                "bottom": 9,
                "left": 9,
                "right": 9
            },
            "margin": {
                "top": 10,
                "bottom": 10,
                "left": 10,
                "right": 10
            }
        },
        "ColumnLayout": {
            "align-vertical": "TOP"
        },
        "UIScrollbar": {
            "parts": {
                "sliderVertical": {
                    "background": "engine:sliderTrack",
                    "background-scale-mode": "tiled",
                    "fixed-width": 18,
                    "background-border": {
                        "top": 9,
                        "bottom": 9,
                        "left": 0,
                        "right": 0
                    }
                },
                "sliderHorizontal": {
                    "background": "engine:sliderTrack",
                    "background-scale-mode": "tiled",
                    "fixed-height": 18,
                    "background-border": {
                        "top": 0,
                        "bottom": 0,
                        "left": 9,
                        "right": 9
                    }
                },
                "handle": {
                    "background": "engine:handle",
                    "fixed-width": 18,
                    "fixed-height": 18
                }
            }
        },
        "UISlider": {
            "text-align-horizontal": "center",
            "text-align-vertical": "middle",
            "fixed-height": 36,
            "parts": {
                "slider": {
                    "background": "engine:sliderTrack",
                    "background-scale-mode": "tiled",
                    "fixed-height": 12,
                    "min-width": 12,
                    "background-border": {
                        "top": 0,
                        "bottom": 0,
                        "left": 9,
                        "right": 9
                    }
                },
                "ticker": {
                    "background": "engine:box",
                    "background-scale-mode": "tiled",
                    "fixed-height": 36,
                    "background-border": {
                        "top": 12,
                        "bottom": 12,
                        "left": 12,
                        "right": 12
                    },
                    "margin": {
                        "top": 4,
                        "bottom": 4,
                        "left": 10,
                        "right": 10
                    },
                    "modes": {
                        "active": {
                            "background": "engine:boxActive"
                        },
                        "disabled": {
                            "background": "engine:boxDisabled",
                            "text-color": "B49E7CFF"
                        }
                    }
                }
            }
        },
        "UIDoubleSlider": {
            "text-align-horizontal": "center",
            "text-align-vertical": "middle",
            "fixed-height": 36,
            "parts": {
                "slider": {
                    "background": "engine:sliderTrack",
                    "background-scale-mode": "tiled",
                    "fixed-height": 12,
                    "min-width": 12,
                    "background-border": {
                        "top": 0,
                        "bottom": 0,
                        "left": 9,
                        "right": 9
                    }
                },
                "tickerLeft": {
                    "background": "engine:box",
                    "background-scale-mode": "tiled",
                    "fixed-height": 36,
                    "background-border": {
                        "top": 12,
                        "bottom": 12,
                        "left": 12,
                        "right": 12
                    },
                    "margin": {
                        "top": 4,
                        "bottom": 4,
                        "left": 10,
                        "right": 10
                    },
                    "modes": {
                        "active": {
                            "background": "engine:boxActive"
                        },
                        "disabled": {
                            "background": "engine:boxDisabled",
                            "text-color": "B49E7CFF"
                        }
                    }
                },
                "tickerRight": {
                    "background": "engine:box",
                    "background-scale-mode": "tiled",
                    "fixed-height": 36,
                    "background-border": {
                        "top": 12,
                        "bottom": 12,
                        "left": 12,
                        "right": 12
                    },
                    "margin": {
                        "top": 4,
                        "bottom": 4,
                        "left": 10,
                        "right": 10
                    },
                    "modes": {
                        "enabled": {
                            "text-color": "FFF3DCFF"
                        },
                        "active": {
                            "background": "engine:boxActive"
                        },
                        "disabled": {
                            "background": "engine:boxDisabled",
                            "text-color": "B49E7CFF"
                        }
                    }
                }
            }
        },
        "UITreeView": {
            "parts": {
                "expand-button": {
                    "background": "engine:button",
                    "background-scale-mode": "tiled",
                    "background-border": {
                        "top": 9,
                        "bottom": 18,
                        "left": 9,
                        "right": 9
                    }
                },
                "tree-node": {
                    "background": "engine:listItem",
                    "background-scale-mode": "tiled",
                    "background-border": {
                        "top": 6,
                        "bottom": 6,
                        "left": 18,
                        "right": 6
                    },
                    "margin": {
                        "top": 6,
                        "bottom": 6,
                        "left": 14,
                        "right": 10
                    },
                    "modes": {
                        "hover": {
                            "background": "engine:listItemHover",
                            "text-color": "FFF3DCFF"
                        },
                        "active": {
                            "background": "engine:listItemSelected",
                            "text-color": "FFF3DCFF"
                        },
                        "disabled": {
                            "background": "engine:listItem",
                            "text-color": "B49E7CFF"
                        },
                        "hover-disabled": {
                            "background": "engine:listItem",
                            "text-color": "B49E7CFF"
                        }
                    }
                }
            }
        }
    }
}
